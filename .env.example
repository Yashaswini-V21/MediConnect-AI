# ============================================================
# MediConnect-AI Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================================

# ------- Flask Configuration -------
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# ------- AI/ML API Keys -------
# Groq API Key (Get free: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Bhashini API Key (Get free: https://bhashini.gov.in)
BHASHINI_API_KEY=your_bhashini_api_key_here

# ------- Firebase Configuration -------
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@yourproject.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

# ------- Email Configuration (Optional - M5) -------
# For SMS/Email notifications (Twilio, SendGrid, etc.)
COACH_EMAIL_TO=your-email@example.com
COACH_WHATSAPP_NUMBER=919999999999

# ------- Database -------
# SQLite is built-in, no setup needed for local dev
# For production, use PostgreSQL
DATABASE_URL=sqlite:///instance/mediconnect.db

# ------- Redis Cache (Optional - M5) -------
# For task queue and session caching
REDIS_URL=redis://localhost:6379/0

# ------- Logging & Analytics -------
LOG_LEVEL=INFO
ANALYTICS_ENABLED=True

# ------- Model Configuration -------
# ML classifier model path (trained artifacts)
ML_MODEL_PATH=backend/models/artifacts/urgency_classifier.pkl
ML_ENCODER_PATH=backend/models/artifacts/label_encoder.pkl

# ------- Deployment Settings -------
# For production deployment on Render/Railway
PORT=5000
WORKERS=2
HOST=0.0.0.0

# ------- Memory & Cache Settings -------
COACH_MEMORY_DIR=.coach_memory
COACH_MEMORY_PATH=

# ============================================================
# NOTES:
# ============================================================
# 1. LOCAL DEVELOPMENT: 
#    - GROQ_API_KEY: Not required if using demo mode
#    - FIREBASE_*: Not required if using local SQLite
#
# 2. ML MODEL:
#    - First time: Run `python -c "from models.ml_classifier import train_and_save_model; train_and_save_model()"`
#    - Artifacts auto-saved to backend/models/artifacts/
#
# 3. PRODUCTION:
#    - Set FLASK_ENV=production
#    - Update SECRET_KEY with strong random string
#    - Set DATABASE_URL to PostgreSQL
#    - Configure all Firebase credentials
#
# 4. SECURITY:
#    - Never commit .env file
#    - Use different keys for dev/staging/prod
#    - Rotate API keys regularly
# ============================================================
