# ════════════════════════════════════════════════════════════════════════════════════
# MediConnect-AI 2.0 — Complete Environment Configuration (M1–M8)
# ════════════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ════════════════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 1: CORE FLASK CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════════════

FLASK_APP=backend/app.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 2: M3 — ADMIN RBAC CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════════════

# Admin authentication token (for X-Admin-Token header in dev)
ADMIN_SECRET_TOKEN=mediconnect-admin-dev-token

# Admin roles (for testing)
ADMIN_ROLES=PLATFORM_ADMIN,HOSPITAL_ADMIN,SUPPORT_STAFF

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 3: AI/ML API KEYS
# ══════════════════════════════════════════════════════════════════════════════════════

# Groq API Key (Get free: https://console.groq.com)
# Model: llama3-8b-8192, llama3-70b-8192
GROQ_API_KEY=gsk_your_groq_api_key_here

# Bhashini API Key (India's Government AI)
# Get from: https://bhashini.gov.in
BHASHINI_API_KEY=your_bhashini_api_key_here

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 4: M5 — NOTIFICATIONS (EMAIL & SMS)
# ══════════════════════════════════════════════════════════════════════════════════════

# SendGrid Email Service
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@mediconnect.health

# Twilio SMS Service
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 5: M6 — LLM PROVIDER CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════════════

# LLM Model Selection
LLM_PROVIDER=groq  # Options: groq, openai, huggingface
LLM_MODEL=llama3-70b-8192
LLM_TEMPERATURE=0.3  # Lower = more deterministic, Higher = more creative

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 6: M7 — SECURITY & ENCRYPTION
# ══════════════════════════════════════════════════════════════════════════════════════

# AES-256 Encryption Key for health data
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# Rate Limiting Configuration
RATE_LIMIT_AI_REQUESTS=30/minute       # LLM calls (expensive)
RATE_LIMIT_BOOKINGS=10/hour            # Appointment bookings
RATE_LIMIT_LOGIN=5/minute              # Login attempts (brute force prevention)
RATE_LIMIT_DEFAULT=1000/hour           # Default limit for all endpoints

# Security Headers
ALLOW_CROSS_ORIGIN=*
HSTS_MAX_AGE=31536000

# Sentry Error Tracking (Production error monitoring)
SENTRY_DSN=https://your_key@sentry.io/your_project_id

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 7: M4 — ANALYTICS & CACHING
# ══════════════════════════════════════════════════════════════════════════════════════

# Redis Cache (for performance optimization)
# Local: redis://localhost:6379/0
# Cloud: redis://default:password@host:port/0
REDIS_URL=redis://localhost:6379/0

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_AGGREGATION_TIME=00:00  # Daily aggregation at midnight UTC
ANALYTICS_RETENTION_DAYS=90       # Keep analytics data for 90 days

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 8: M8 — DEPLOYMENT & MONITORING
# ══════════════════════════════════════════════════════════════════════════════════════

# Environment
ENVIRONMENT=development  # development, staging, production
APP_VERSION=2.0.0
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# API Versioning
API_VERSION=v1
API_SUPPORTED_VERSIONS=v1,v2

# Monitoring & Observability
AUDIT_LOGGING_ENABLED=true
REQUEST_LOGGING_ENABLED=true
HEALTH_CHECK_INTERVAL=60  # seconds

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 9: CONTINUED FROM ORIGINAL .env.example
# ══════════════════════════════════════════════════════════════════════════════════════
TWILIO_PHONE_NUMBER=+91999999999  # Your Twilio verified number

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 5: M7 — SECURITY & ENCRYPTION
# ══════════════════════════════════════════════════════════════════════════════════════

# AES-256 Encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_encryption_key_here

# Rate limiting configuration
RATE_LIMIT_ENABLED=True
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=30
RATE_LIMIT_BOOKING_PER_HOUR=10

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 6: FIREBASE CONFIGURATION (Optional - for production auth)
# ══════════════════════════════════════════════════════════════════════════════════════

# Firebase Service Account (download from Firebase Console → Project Settings)
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@yourproject.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 7: DATABASE CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════════════

# Local Development: SQLite (built-in, no setup needed)
DATABASE_URL=sqlite:///instance/mediconnect.db

# Production: PostgreSQL (replace with actual URL)
# DATABASE_URL=postgresql://user:password@hostname:5432/mediconnect_prod

# Database connection pooling
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_RECYCLE=3600

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 8: M5 — REDIS CACHE & CELERY (Optional - for async tasks)
# ══════════════════════════════════════════════════════════════════════════════════════

# Redis connection URL (for task queue and session caching)
REDIS_URL=redis://localhost:6379/0

# Celery broker
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 9: ML MODEL CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════════════

# Path to trained ML models (auto-generated on first run)
ML_MODEL_PATH=backend/models/artifacts/urgency_classifier.pkl
ML_ENCODER_PATH=backend/models/artifacts/label_encoder.pkl
ML_SCALER_PATH=backend/models/artifacts/scaler.pkl

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 10: LOGGING & ANALYTICS
# ══════════════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=INFO
ANALYTICS_ENABLED=True
AUDIT_LOGGING_ENABLED=True

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 11: M8 — DEPLOYMENT CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════════════

# Deployment environment
ENVIRONMENT=development  # development, staging, production

# Server configuration
PORT=5000
HOST=0.0.0.0
WORKERS=4

# CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://mediconnect-ai-nu.vercel.app

# ══════════════════════════════════════════════════════════════════════════════════════
# SECTION 12: FRONTEND CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════════════

# API base URL (for React app)
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_FIREBASE_CONFIG_JSON={}

# ════════════════════════════════════════════════════════════════════════════════════════
# QUICK START GUIDE
# ════════════════════════════════════════════════════════════════════════════════════════
#
# LOCAL DEVELOPMENT (No external services):
#   1. Copy this file to .env
#   2. Update GROQ_API_KEY and BHASHINI_API_KEY only
#   3. Run: python backend/app.py
#
# PRODUCTION DEPLOYMENT:
#   1. Set FLASK_ENV=production
#   2. Update all API keys and credentials
#   3. Set DATABASE_URL to PostgreSQL
#   4. Set ENCRYPTION_KEY with new key (see notes below)
#   5. Configure Twilio & SendGrid for notifications
#   6. Deploy to Render (backend) and Vercel (frontend)
#
# GENERATE ENCRYPTION KEY:
#   python -c "from cryptography.fernet import Fernet; print('ENCRYPTION_KEY=' + Fernet.generate_key().decode())"
#
# SECURITY CHECKLIST:
#   ☐ Never commit .env file to git
#   ☐ Use strong SECRET_KEY in production (minimum 32 chars)
#   ☐ Rotate API keys every 90 days
#   ☐ Use different .env files for dev/staging/prod
#   ☐ Enable audit logging (AUDIT_LOGGING_ENABLED=True)
# ════════════════════════════════════════════════════════════════════════════════════════
