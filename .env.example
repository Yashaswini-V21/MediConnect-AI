# =========================================================================
# MediConnect-AI: Root / Backend Environment Variables Example
# =========================================================================
# Copy this file to `.env` in the root or backend directory and fill values.

# ------- Flask / Security Configuration -------
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_SECRET_KEY=your-flask-secret-key-here-must-be-strong
SECRET_KEY=your-fallback-secret-key-here
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Persistent AES-256 Encryption Key (Crucial for patient health data privacy)
# Generate one using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-base64-encryption-key-here

# Security / Access Controls
ADMIN_SECRET_TOKEN=admin-token-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ------- Database & Caching -------
# For local SQLite development (default)
DATABASE_URL=sqlite:///instance/mediconnect.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Socket.IO / Celery Redis Queue (Optional, default is local in-memory threading)
# REDIS_URL=redis://localhost:6379/0

# ------- AI/ML API Keys -------
# Groq API Key (For LLama-based clinical assistant, get free: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Bhashini AI Translation API Key (Get at: https://bhashini.gov.in)
BHASHINI_API_KEY=your_bhashini_api_key_here

# Sarvam AI Translation & Kannada Chatbot Key (Optional)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai/v1/translate

# ------- Firebase Service Account Configuration -------
# Download this JSON from Firebase Console -> Project Settings -> General -> Service Accounts
# Wrap private key inside quotes.
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@yourproject.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

# ------- Notifications & SOS Configuration -------
COACH_EMAIL_TO=doctor-alert@mediconnect.com
COACH_WHATSAPP_NUMBER=919999999999

# ------- Logging & Monitoring -------
LOG_LEVEL=INFO
ANALYTICS_ENABLED=True
