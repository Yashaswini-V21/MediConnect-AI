# Example frontend environment variables (DO NOT COMMIT real secrets)
# Copy to frontend/.env.local and fill values locally.

REACT_APP_API_URL=http://localhost:5000
REACT_APP_FIREBASE_API_KEY=CHANGE_ME_FIREBASE_API_KEY
REACT_APP_FIREBASE_AUTH_DOMAIN=CHANGE_ME_FIREBASE_AUTH_DOMAIN
REACT_APP_FIREBASE_PROJECT_ID=CHANGE_ME_FIREBASE_PROJECT_ID
REACT_APP_FIREBASE_APP_ID=CHANGE_ME_FIREBASE_APP_ID
REACT_APP_GOOGLE_MAPS_API_KEY=CHANGE_ME_GOOGLE_MAPS_API_KEY
REACT_APP_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
# API Configuration
REACT_APP_API_URL=http://localhost:5000

# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=

# Google Maps API Key (Optional)
# Get your key from: https://developers.google.com/maps/documentation/javascript/get-api-key
REACT_APP_GOOGLE_MAPS_API_KEY=

# Application Settings
REACT_APP_NAME=MediConnect
REACT_APP_VERSION=1.0.0
