# =========================================================================
# MediConnect-AI: Frontend Environment Variables Example
# =========================================================================
# Copy this file to `.env` or `.env.local` and fill in the values before launching the frontend.

# API Base URL
REACT_APP_API_URL=http://localhost:5000

# Firebase Configuration (Required for Social Auth & Email OTP Integration)
# Get these from Firebase Console -> Project Settings -> General -> Your Apps
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id_here

# Google Maps API Key (Optional, enables maps for Hospital Finder)
# Get this from: https://console.cloud.google.com/
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Application Metadata
REACT_APP_NAME=MediConnect
REACT_APP_VERSION=1.0.0
REACT_APP_ENV=development
