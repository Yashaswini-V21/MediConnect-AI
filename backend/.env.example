# Flask Configuration
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
FLASK_ENV=development

# Database
DATABASE_URL=sqlite:///mediconnect.db

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email OTP Configuration (Optional - For Production)
# Leave empty for development mode (OTP shown in console)
SENDER_EMAIL=
SENDER_PASSWORD=

# Server Configuration
PORT=5000

# Azure OpenAI Configuration
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Azure Translator Configuration
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_LOCATION=your_location_here

# Firebase Admin Configuration (for backend token verification)
# Use one option:
# 1) Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_FILE=
# 2) Full service account JSON as one-line string
FIREBASE_SERVICE_ACCOUNT_JSON=
# 3) Project ID only (limited mode)
FIREBASE_PROJECT_ID=
