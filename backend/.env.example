# Example backend environment variables (DO NOT COMMIT real secrets)
# Copy to backend/.env and fill in values for local development only.

SECRET_KEY=CHANGE_ME_SECRET_KEY
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
FLASK_ENV=development

# Database
DATABASE_URL=sqlite:///mediconnect.db

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# AI / Third-party keys
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY
BHASHINI_API_KEY=CHANGE_ME_BHASHINI_API_KEY
SENDGRID_API_KEY=CHANGE_ME_SENDGRID_API_KEY
TWILIO_ACCOUNT_SID=CHANGE_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=CHANGE_ME_TWILIO_PHONE_NUMBER

# Encryption / misc
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY
GOOGLE_MAPS_API_KEY=CHANGE_ME_GOOGLE_MAPS_API_KEY
ADMIN_SECRET_TOKEN=CHANGE_ME_ADMIN_SECRET_TOKEN
# Flask Configuration
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
FLASK_ENV=development

# Database
DATABASE_URL=sqlite:///mediconnect.db

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email OTP Configuration (Optional - For Production)
# Leave empty for development mode (OTP shown in console)
SENDER_EMAIL=
SENDER_PASSWORD=

# Server Configuration
PORT=5000

# LOCAL RULE-BASED SYSTEM - NO EXTERNAL APIS REQUIRED
# All features work with local algorithms and databases

# Firebase Admin Configuration (for backend token verification)
# Use one option:
# 1) Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_FILE=
# 2) Full service account JSON as one-line string
FIREBASE_SERVICE_ACCOUNT_JSON=
# 3) Project ID only (limited mode)
FIREBASE_PROJECT_ID=

# AI Provider Configuration
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

